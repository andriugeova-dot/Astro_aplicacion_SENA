---
import 'bootstrap/dist/css/bootstrap.min.css';
import 'bootstrap-icons/font/bootstrap-icons.css';
import Sidebar from '../components/sidebar.astro';
import NavbarUsuario from '../components/navbarusuario.astro';

interface SidebarLink {
	text: string;
	href: string;
	icon: string;
}

interface Props {
	title?: string;
	/** Si se pasan links, el Layout monta sidebar + navbar (paneles internos). */
	links?: SidebarLink[];
	subtitulo?: string;
	/**
	 * Roles (idRol) que pueden ver esta página. Si el usuario logueado no
	 * tiene un rol permitido, se lo redirige a su propio panel.
	 * Solo tiene efecto en páginas con `links` (con sidebar/navbar).
	 */
	rolesPermitidos?: number[];
}

const { title = 'Asistencias SENA', links, subtitulo = 'Usuario', rolesPermitidos } = Astro.props;
const conChrome = Array.isArray(links) && links.length > 0;
const rolesJson = JSON.stringify(rolesPermitidos ?? []);
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		{conChrome ? (
			<div class="app-shell" data-roles-permitidos={rolesJson}>
				<Sidebar links={links!} />
				<div class="app-main">
					<NavbarUsuario aprendiz={{ nombre: '', apellido: '' }} subtitulo={subtitulo} />
					<div class="app-content">
						<slot />
					</div>
				</div>
			</div>
		) : (
			<slot />
		)}
	</body>
</html>

<script>
	// Cablea el sidebar/navbar con la sesión real y protege el panel por rol.
	// Solo corre si el Layout montó el "chrome" (sidebar+navbar), es decir,
	// si la página pasó `links` como prop.
	import { exigirSesion, exigirRol } from '../lib/auth.ts';

	const shell = document.querySelector<HTMLElement>('.app-shell');

	if (shell) {
		const rolesPermitidos: number[] = JSON.parse(shell.dataset.rolesPermitidos ?? '[]');

		const sesion = rolesPermitidos.length > 0
			? exigirRol(rolesPermitidos)
			: exigirSesion();

		if (sesion) {
			const { usuario } = sesion;
			const nombreEl = shell.querySelector('.profile-info .name');
			const avatarEl = shell.querySelector('.avatar');
			if (nombreEl) nombreEl.textContent = usuario.nombre;
			if (avatarEl) avatarEl.textContent = `${usuario.nombre.charAt(0)}${usuario.apellido.charAt(0)}`;
		}

		// Toggle del sidebar en móvil (el botón existía pero no tenía listener).
		const menuBtn = document.getElementById('menu-toggle');
		const sidebar = document.getElementById('sidebar');
		const backdrop = document.getElementById('sidebar-backdrop');

		menuBtn?.addEventListener('click', () => {
			sidebar?.classList.toggle('open');
			backdrop?.classList.toggle('show');
		});
		backdrop?.addEventListener('click', () => {
			sidebar?.classList.remove('open');
			backdrop?.classList.remove('show');
		});
	}
</script>

<style is:global>
	:root {
		--sena-verde: #39a900;
		--sena-verde-oscuro: #267300;
		--sena-naranja: #ff7f41;
		--sena-tinta: #0c2b23;
		--sena-tinta-suave: #12362c;
		--sena-crema: #f5f7f2;
		--fuente-display: 'Space Grotesk', 'Inter', sans-serif;
		--fuente-cuerpo: 'Inter', sans-serif;
	}

	html,
	body {
		margin: 0;
		width: 100%;
		min-height: 100%;
	}

	body {
		font-family: var(--fuente-cuerpo);
		background-color: var(--sena-crema);
		color: var(--sena-tinta);
	}

	h1,
	h2,
	h3,
	h4,
	.font-display {
		font-family: var(--fuente-display);
	}

	:focus-visible {
		outline: 2px solid var(--sena-naranja);
		outline-offset: 2px;
	}

	@media (prefers-reduced-motion: reduce) {
		*,
		*::before,
		*::after {
			animation-duration: 0.001ms !important;
			animation-iteration-count: 1 !important;
			transition-duration: 0.001ms !important;
		}
	}

	/* Paneles internos: sidebar fija (260px, ver sidebar.astro) + contenido. */
	.app-shell {
		display: flex;
		min-height: 100vh;
	}

	.app-main {
		flex: 1;
		min-width: 0;
		margin-left: 260px;
		display: flex;
		flex-direction: column;
	}

	.app-content {
		flex: 1;
	}

	@media (max-width: 900px) {
		.app-main {
			margin-left: 0;
		}
	}
</style>
