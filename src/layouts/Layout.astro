---
import 'bootstrap/dist/css/bootstrap.min.css';
import 'bootstrap-icons/font/bootstrap-icons.css';

interface Props {
	title?: string;
}

const { title = 'Asistencias SENA' } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	:root {
		--sena-verde: #39a900;
		--sena-verde-oscuro: #267300;
		--sena-naranja: #ff7f41;
		--sena-tinta: #0c2b23;
		--sena-tinta-suave: #12362c;
		--sena-crema: #f5f7f2;
		--fuente-display: 'Space Grotesk', 'Inter', sans-serif;
		--fuente-cuerpo: 'Inter', sans-serif;
	}

	html,
	body {
		margin: 0;
		width: 100%;
		min-height: 100%;
	}

	body {
		font-family: var(--fuente-cuerpo);
		background-color: var(--sena-crema);
		color: var(--sena-tinta);
	}

	h1,
	h2,
	h3,
	h4,
	.font-display {
		font-family: var(--fuente-display);
	}

	:focus-visible {
		outline: 2px solid var(--sena-naranja);
		outline-offset: 2px;
	}

	@media (prefers-reduced-motion: reduce) {
		*,
		*::before,
		*::after {
			animation-duration: 0.001ms !important;
			animation-iteration-count: 1 !important;
			transition-duration: 0.001ms !important;
		}
	}
</style>
