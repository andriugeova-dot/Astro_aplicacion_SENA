---
import Navbar from '../components/navbarusuario.astro';

interface Props {
  title: string;
}

const { title } = Astro.props;

const navLinks = [
  { text: 'Home', href: '/' },
  { text: 'Registrate', href: '/registro' },
  { text: 'Login', href: '/login', isButton: true }
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
  </head>
  <body>
    <Navbar links={navLinks} />
    <slot />
  </body>
</html>



