---
import Navbar from "../components/navbarusuario.astro";

interface NavLink{
    text:string;
    href:string;
}

interface Props{
    title:string;
    links?:NavLink[];
    aprendiz?:any;
}

const {
    title,
    links = [],
    aprendiz = { nombre: "", apellido: "" }
} = Astro.props;
---

<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css"/>
</head>

<body>
  <Navbar
    links={links}
    aprendiz={aprendiz}
  />

  <main>
    <slot/>
  </main>
</body>

</html>

<style>
html,
body{
  margin:0;
  padding:0;
  background:#f4f7fb;
  font-family:system-ui,sans-serif;
}

*{
  box-sizing:border-box;
}
</style>