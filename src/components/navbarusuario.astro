---
interface NavLink {
  text: string;
  href: string;
  isButton?: boolean;
}

interface Props {
  links: NavLink[];
}

const { links } = Astro.props;
---

<header class="header">
  <nav class="navbar">
    <div class="logo">SENA</div>
    <ul class="nav-links">
      {links.map((link) => (
        <li>
          <a href={link.href} class={link.isButton ? 'btn' : ''}>
            {link.text}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<style>
  .header {
    background-color: #2e4a62;
    padding: 1rem 2rem;
  }

  .navbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    max-width: 1200px;
    margin: 0 auto;
  }

  .logo {
    color: #81dc53e1;
    font-weight: bold;
    font-size: 1.4rem;
  }

  .nav-links {
    list-style: none;
    display: flex;
    gap: 1.5rem;
    margin: 0;
    padding: 0;
  }

  .nav-links a {
    color: white;
    text-decoration: none;
    font-size: 0.95rem;
  }

  .nav-links a:hover {
    color: #39A900;
  }

  .nav-links a.btn {
    background-color: #39A900;
    padding: 0.5rem 1.2rem;
    border-radius: 6px;
  }
</style>


















