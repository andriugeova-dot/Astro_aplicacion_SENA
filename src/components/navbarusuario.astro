---
interface Props{
  links: any[];
  aprendiz: any;
}

const {
  links,
  aprendiz
} = Astro.props;
---

<header class="header">
  <nav class="navbar">
    <div class="logo">
      <i class="bi bi-mortarboard-fill"></i>
      <span> SENA</span>
    </div>

    <ul class="nav-links">
      {
        links.map(link => (
          <li>
            <a href={link.href}>
              {link.text}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="right">
      <div class="profile">
        <div class="avatar">
          {aprendiz.nombre.charAt(0)}
          {aprendiz.apellido.charAt(0)}
        </div>

        <div class="profile-info">
          <span class="name">
            {aprendiz.nombre}
          </span>
          <span class="role">
            Aprendiz
          </span>
        </div>
      </div>
    </div>
  </nav>
</header>

<style>
.header{
  background:white;
  height:75px;
  border-bottom:1px solid #e5e7eb;
  position:sticky;
  top:0;
  z-index:999;
}

.navbar{
  max-width:1400px;
  margin:auto;
  height:100%;
  display:flex;
  justify-content:space-between;
  align-items:center;
  padding:0 30px;
}

.logo{
  display:flex;
  align-items:center;
  gap:12px;
  font-size:1.3rem;
  font-weight:bold;
  color:#39A900;
}

.logo i{
  font-size:2rem;
}

.nav-links{
  display:flex;
  gap:35px;
  list-style:none;
  margin:0;
  padding:0;
}

.nav-links a{
  text-decoration:none;
  color:#374151;
  font-weight:500;
  transition:.3s;
}

.nav-links a:hover{
  color:#39A900;
}

.right{
  display:flex;
  align-items:center;
  gap:25px;
}

.profile{
  display:flex;
  align-items:center;
  gap:12px;
  cursor:pointer;
}

.avatar{
  width:42px;
  height:42px;
  border-radius:50%;
  background:#39A900;
  display:flex;
  justify-content:center;
  align-items:center;
  color:white;
  font-weight:bold;
}

.profile-info{
  display:flex;
  flex-direction:column;
}

.name{
  font-weight:600;
  color:#111827;
}

.role{
  font-size:.8rem;
  color:#6b7280;
}
</style>