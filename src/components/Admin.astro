---
interface Props {
  admin: any;
}

const { admin } = Astro.props;

const fecha = new Date().toLocaleDateString("es-CO", {
  day: "numeric",
  month: "long",
  year: "numeric",
});

const stats = [
  { icon: "bi-people-fill", valor: 312, label: "Total registrados", titulo: "Usuarios" },
  { icon: "bi-person-workspace", valor: 18, label: "Activos", titulo: "Instructores" },
  { icon: "bi-mortarboard-fill", valor: 284, label: "Total activos", titulo: "Aprendices" },
  { icon: "bi-journal-bookmark-fill", valor: 12, label: "En formación", titulo: "Fichas" },
];

const usuariosRecientes = [
  { nombre: "Marta Díaz", correo: "marta@gmail.com", rol: "Instructor", fecha: "01 ago 2026" },
  { nombre: "Andrés Mendoza", correo: "andres@gmail.com", rol: "Aprendiz", fecha: "31 jul 2026" },
  { nombre: "Laura Torres", correo: "laura@gmail.com", rol: "Aprendiz", fecha: "30 jul 2026" },
];

const fichas = [
  { icon: "bi-laptop", numero: "ADSO - 2876543", programa: "Análisis y Desarrollo de Sistemas de Información", instructor: "Marta Díaz", aprendices: 28, estado: "ACTIVA" },
  { icon: "bi-code-slash", numero: "ADSO - 2876544", programa: "Análisis y Desarrollo de Sistemas de Información", instructor: "Carlos Gómez", aprendices: 31, estado: "ACTIVA" },
  { icon: "bi-diagram-3-fill", numero: "SOFTWARE - 3001123", programa: "Desarrollo de Software", instructor: "Julián Ríos", aprendices: 25, estado: "ACTIVA" },
];

const acciones = [
  { icon: "bi-person-plus-fill", texto: "Crear usuario" },
  { icon: "bi-journal-plus", texto: "Crear ficha" },
  { icon: "bi-shield-lock-fill", texto: "Gestionar roles" },
  { icon: "bi-mortarboard-fill", texto: "Gestionar programas" },
];
---

<div class="dashboard-admin">

  <section class="welcome">
    <div>
      <h2>¡Bienvenido, {admin.nombre} {admin.apellido}!</h2>
      <p>Panel administración del sistema.</p>
    </div>

    <div class="date-badge">
      <i class="bi bi-calendar3"></i>
      <span>{fecha}</span>
    </div>
  </section>
 
</div>

<style>

.dashboard-admin{
  padding:35px;
  max-width:1400px;
  margin:auto;
}

.welcome{
  display:flex;
  justify-content:space-between;
  align-items:center;
  margin-bottom:30px;
  flex-wrap:wrap;
  gap:15px;
}

.welcome h2{
  font-size:1.5rem;
  margin-bottom:4px;
  color:#1f2937;
}

.welcome p{
  color:#6b7280;
  font-size:.9rem;
}

.date-badge{
  display:flex;
  align-items:center;
  gap:10px;
  background:white;
  border:1px solid #e5e7eb;
  border-radius:10px;
  padding:10px 18px;
  font-size:.9rem;
  color:#374151;
  font-weight:500;
}

/* STATS */
.stats-grid{
  display:grid;
  grid-template-columns:repeat(4, 1fr);
  gap:20px;
  margin-bottom:25px;
}

.stat-card{
  background:white;
  border-radius:16px;
  padding:22px;
  display:flex;
  align-items:center;
  gap:16px;
  box-shadow:0 4px 15px rgba(0,0,0,.04);
}

.stat-icon{
  width:55px;
  height:55px;
  border-radius:14px;
  background:#dcfce7;
  color:#39A900;
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:1.5rem;
  flex-shrink:0;
}

.stat-title{
  font-size:.85rem;
  color:#6b7280;
  display:block;
}

.stat-info h3{
  font-size:1.6rem;
  margin:2px 0;
  color:#1f2937;
}

.stat-label{
  font-size:.78rem;
  color:#9ca3af;
}

/* TWO COL */
.two-col{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:20px;
  margin-bottom:25px;
}

.card{
  background:white;
  border-radius:16px;
  padding:22px;
  box-shadow:0 4px 15px rgba(0,0,0,.04);
}

.card-header{
  display:flex;
  justify-content:space-between;
  align-items:center;
  margin-bottom:18px;
}

.card-header h3{
  font-size:1rem;
  display:flex;
  align-items:center;
  gap:8px;
  color:#1f2937;
}

.card-header h3 i{
  color:#39A900;
}

.link-btn{
  background:none;
  border:1px solid #e5e7eb;
  border-radius:8px;
  padding:6px 14px;
  font-size:.8rem;
  color:#374151;
  cursor:pointer;
  font-family:inherit;
}

.link-btn:hover{
  background:#f3f4f6;
}

/* USUARIOS */
.usuario-list{
  display:flex;
  flex-direction:column;
}

.usuario-item{
  display:flex;
  align-items:center;
  gap:14px;
  padding:14px 0;
  border-bottom:1px solid #f3f4f6;
}

.usuario-item:last-child{
  border-bottom:none;
}

.usuario-avatar{
  width:40px;
  height:40px;
  border-radius:50%;
  background:#39A900;
  color:white;
  font-weight:bold;
  display:flex;
  align-items:center;
  justify-content:center;
  flex-shrink:0;
}

.usuario-info{
  flex:1;
  min-width:0;
}

.usuario-info strong{
  font-size:.9rem;
  color:#1f2937;
  display:block;
}

.usuario-info p{
  font-size:.78rem;
  color:#6b7280;
  margin-top:2px;
}

.rol-badge{
  font-size:.68rem;
  font-weight:700;
  padding:4px 10px;
  border-radius:8px;
  white-space:nowrap;
}

.rol-badge.instructor{
  background:#dbeafe;
  color:#2563eb;
}

.rol-badge.aprendiz{
  background:#dcfce7;
  color:#15803d;
}

.usuario-fecha{
  font-size:.75rem;
  color:#9ca3af;
  min-width:75px;
  text-align:right;
}

/* FICHAS */
.ficha-list{
  display:flex;
  flex-direction:column;
}

.ficha-item{
  display:flex;
  align-items:center;
  gap:14px;
  padding:14px 0;
  border-bottom:1px solid #f3f4f6;
}

.ficha-item:last-child{
  border-bottom:none;
}

.ficha-icon{
  width:44px;
  height:44px;
  border-radius:12px;
  background:#dcfce7;
  color:#39A900;
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:1.2rem;
  flex-shrink:0;
}

.ficha-info{
  flex:1;
  min-width:0;
}

.ficha-titulo{
  display:flex;
  align-items:center;
  gap:8px;
}

.ficha-titulo strong{
  font-size:.9rem;
  color:#1f2937;
}

.estado{
  background:#dcfce7;
  color:#15803d;
  font-size:.65rem;
  font-weight:700;
  padding:2px 8px;
  border-radius:6px;
}

.ficha-info p{
  font-size:.8rem;
  color:#6b7280;
  margin-top:2px;
}

.ficha-instructor{
  font-size:.75rem;
  color:#9ca3af;
}

.ficha-aprendices{
  text-align:right;
  display:flex;
  flex-direction:column;
}

.ficha-aprendices strong{
  color:#39A900;
  font-size:1.1rem;
}

.ficha-aprendices span{
  font-size:.7rem;
  color:#9ca3af;
}

/* ACCIONES */
.acciones-section{
  margin-bottom:25px;
}

.acciones-grid{
  display:grid;
  grid-template-columns:repeat(4, 1fr);
  gap:15px;
}

.accion-btn{
  background:#f8fafc;
  border:none;
  border-radius:14px;
  padding:22px;
  display:flex;
  flex-direction:column;
  align-items:center;
  gap:10px;
  cursor:pointer;
  transition:.2s;
  font-family:inherit;
  appearance:none;
  -webkit-appearance:none;
}

.accion-btn i{
  font-size:1.6rem;
  color:#39A900;
}

.accion-btn span{
  font-size:.85rem;
  color:#374151;
  font-weight:500;
}

.accion-btn:hover{
  background:#dcfce7;
  transform:translateY(-3px);
}

@media(max-width:1100px){
  .stats-grid{ grid-template-columns:repeat(2, 1fr); }
  .two-col{ grid-template-columns:1fr; }
  .acciones-grid{ grid-template-columns:repeat(2, 1fr); }
}

@media(max-width:768px){
  .stats-grid{ grid-template-columns:1fr; }
  .acciones-grid{ grid-template-columns:1fr; }
}

</style>