---
interface Props {
  instructor: any;
}

const { instructor } = Astro.props;

const fecha = new Date().toLocaleDateString("es-CO", {
  day: "numeric",
  month: "long",
  year: "numeric",
});

const stats = [
  { icon: "bi-people-fill", valor: 84, label: "Total activos", titulo: "Aprendices" },
  { icon: "bi-calendar3", valor: 6, label: "Clases programadas", titulo: "Horarios" },
  { icon: "bi-journal-bookmark-fill", valor: 3, label: "A tu cargo", titulo: "Fichas" },
];

const fichas = [
  { icon: "bi-laptop", numero: "ADSO - 2876543", nombre: "Análisis y Desarrollo de Sistemas de Información", aprendices: 28, estado: "ACTIVA" },
  { icon: "bi-code-slash", numero: "ADSO - 2876544", nombre: "Análisis y Desarrollo de Sistemas de Información", aprendices: 31, estado: "ACTIVA" },
  { icon: "bi-diagram-3-fill", numero: "SOFTWARE - 3001123", nombre: "Desarrollo de Software", aprendices: 25, estado: "ACTIVA" },
];

const clases = [
  { hora: "08:00", horaFin: "08:50", ficha: "ADSO - 2876543", asignatura: "Análisis y Desarrollo de Sistemas", aula: "Aula 302", aprendices: 28 },
  { hora: "10:00", horaFin: "10:50", ficha: "SOFTWARE - 3001123", asignatura: "Desarrollo de Software", aula: "Aula 205", aprendices: 25 },
  { hora: "14:00", horaFin: "14:50", ficha: "ADSO - 2876544", asignatura: "Análisis y Desarrollo de Sistemas", aula: "Aula 301", aprendices: 31 },
];

const acciones = [
  { icon: "bi-person-check-fill", texto: "Registrar asistencia" },
  { icon: "bi-file-earmark-text-fill", texto: "Ver reportes" },
  { icon: "bi-calendar-week-fill", texto: "Administrar horarios" },
  { icon: "bi-people-fill", texto: "Gestionar aprendices" },
];
---

<div class="dashboard-instructor">

  <section class="welcome">
    <div>
      <h2>¡Bienvenido, {instructor.nombre} {instructor.apellido}!</h2>
      <p>Aquí tienes un resumen de tus actividades del día.</p>
    </div>

    <div class="date-badge">
      <i class="bi bi-calendar3"></i>
      <span>{fecha}</span>
    </div>
  </section>

  <!-- STATS -->
  <section class="stats-grid">
    {stats.map(stat => (
      <div class="stat-card">
        <div class="stat-icon">
          <i class={`bi ${stat.icon}`}></i>
        </div>
        <div class="stat-info">
          <span class="stat-title">{stat.titulo}</span>
          <h3>{stat.valor}</h3>
          <span class="stat-label">{stat.label}</span>
        </div>
      </div>
    ))}
  </section>

  <!-- FICHAS + CLASES -->
  <section class="two-col">

    <div class="card">
      <div class="card-header">
        <h3><i class="bi bi-people-fill"></i> Mis Fichas</h3>
        <button class="link-btn">Ver todas</button>
      </div>

      <div class="ficha-list">
        {fichas.map(ficha => (
          <div class="ficha-item">
            <div class="ficha-icon">
              <i class={`bi ${ficha.icon}`}></i>
            </div>
            <div class="ficha-info">
              <div class="ficha-titulo">
                <strong>{ficha.numero}</strong>
                <span class="estado">{ficha.estado}</span>
              </div>
              <p>{ficha.nombre}</p>
            </div>
            <div class="ficha-aprendices">
              <strong>{ficha.aprendices}</strong>
              <span>Aprendices</span>
            </div>
            <i class="bi bi-chevron-right"></i>
          </div>
        ))}
      </div>
    </div>

    <div class="card">
      <div class="card-header">
        <h3><i class="bi bi-calendar3"></i> Próximas clases</h3>
        <button class="link-btn">Ver horario</button>
      </div>

      <div class="clase-list">
        {clases.map(clase => (
          <div class="clase-item">
            <div class="clase-hora">
              <strong>{clase.hora}</strong>
              <span>{clase.horaFin}</span>
            </div>
            <div class="clase-info">
              <strong>{clase.ficha}</strong>
              <p>{clase.asignatura}</p>
              <span>{clase.aula}</span>
            </div>
            <div class="clase-aprendices">
              <i class="bi bi-people-fill"></i>
              {clase.aprendices}
            </div>
          </div>
        ))}
      </div>
    </div>

  </section>

  <!-- ACCIONES -->
  <section class="acciones-section">

    <div class="card">
      <div class="card-header">
        <h3><i class="bi bi-lightning-fill"></i> Acciones rápidas</h3>
      </div>

      <div class="acciones-grid">
        {acciones.map(accion => (
          <button class="accion-btn">
            <i class={`bi ${accion.icon}`}></i>
            <span>{accion.texto}</span>
          </button>
        ))}
      </div>
    </div>

  </section>

</div>

<style>

.dashboard-instructor{
  padding:35px;
  max-width:1400px;
  margin:auto;
}

.welcome{
  display:flex;
  justify-content:space-between;
  align-items:center;
  margin-bottom:30px;
  flex-wrap:wrap;
  gap:15px;
}

.welcome h2{
  font-size:1.5rem;
  margin-bottom:4px;
  color:#1f2937;
}

.welcome p{
  color:#6b7280;
  font-size:.9rem;
}

.date-badge{
  display:flex;
  align-items:center;
  gap:10px;
  background:white;
  border:1px solid #e5e7eb;
  border-radius:10px;
  padding:10px 18px;
  font-size:.9rem;
  color:#374151;
  font-weight:500;
}

/* STATS */
.stats-grid{
  display:grid;
  grid-template-columns:repeat(3, 1fr);
  gap:20px;
  margin-bottom:25px;
}

.stat-card{
  background:white;
  border-radius:16px;
  padding:22px;
  display:flex;
  align-items:center;
  gap:16px;
  box-shadow:0 4px 15px rgba(0,0,0,.04);
}

.stat-icon{
  width:55px;
  height:55px;
  border-radius:14px;
  background:#dcfce7;
  color:#39A900;
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:1.5rem;
  flex-shrink:0;
}

.stat-title{
  font-size:.85rem;
  color:#6b7280;
  display:block;
}

.stat-info h3{
  font-size:1.6rem;
  margin:2px 0;
  color:#1f2937;
}

.stat-label{
  font-size:.78rem;
  color:#9ca3af;
}

/* TWO COL */
.two-col{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:20px;
  margin-bottom:25px;
}

.card{
  background:white;
  border-radius:16px;
  padding:22px;
  box-shadow:0 4px 15px rgba(0,0,0,.04);
}

.card-header{
  display:flex;
  justify-content:space-between;
  align-items:center;
  margin-bottom:18px;
}

.card-header h3{
  font-size:1rem;
  display:flex;
  align-items:center;
  gap:8px;
  color:#1f2937;
}

.card-header h3 i{
  color:#39A900;
}

.link-btn{
  background:none;
  border:1px solid #e5e7eb;
  border-radius:8px;
  padding:6px 14px;
  font-size:.8rem;
  color:#374151;
  cursor:pointer;
  font-family:inherit;
}

.link-btn:hover{
  background:#f3f4f6;
}

/* FICHAS */
.ficha-list{
  display:flex;
  flex-direction:column;
}

.ficha-item{
  display:flex;
  align-items:center;
  gap:14px;
  padding:14px 0;
  border-bottom:1px solid #f3f4f6;
  cursor:pointer;
}

.ficha-item:last-child{
  border-bottom:none;
}

.ficha-icon{
  width:44px;
  height:44px;
  border-radius:12px;
  background:#dcfce7;
  color:#39A900;
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:1.2rem;
  flex-shrink:0;
}

.ficha-info{
  flex:1;
  min-width:0;
}

.ficha-titulo{
  display:flex;
  align-items:center;
  gap:8px;
}

.ficha-titulo strong{
  font-size:.9rem;
  color:#1f2937;
}

.estado{
  background:#dcfce7;
  color:#15803d;
  font-size:.65rem;
  font-weight:700;
  padding:2px 8px;
  border-radius:6px;
}

.ficha-info p{
  font-size:.8rem;
  color:#6b7280;
  margin-top:2px;
}

.ficha-aprendices{
  text-align:right;
  display:flex;
  flex-direction:column;
}

.ficha-aprendices strong{
  color:#39A900;
  font-size:1.1rem;
}

.ficha-aprendices span{
  font-size:.7rem;
  color:#9ca3af;
}

.ficha-item > i{
  color:#9ca3af;
}

/* CLASES */
.clase-list{
  display:flex;
  flex-direction:column;
}

.clase-item{
  display:flex;
  gap:16px;
  padding:14px 0;
  border-bottom:1px solid #f3f4f6;
  align-items:center;
}

.clase-item:last-child{
  border-bottom:none;
}

.clase-hora{
  display:flex;
  flex-direction:column;
  color:#39A900;
  font-size:.85rem;
  min-width:50px;
}

.clase-info{
  flex:1;
}

.clase-info strong{
  font-size:.9rem;
  color:#1f2937;
}

.clase-info p{
  font-size:.82rem;
  color:#374151;
  margin:2px 0;
}

.clase-info span{
  font-size:.75rem;
  color:#9ca3af;
}

.clase-aprendices{
  display:flex;
  align-items:center;
  gap:6px;
  color:#374151;
  font-size:.9rem;
  font-weight:600;
}

/* ACCIONES */
.acciones-section{
  margin-bottom:25px;
}

.acciones-grid{
  display:grid;
  grid-template-columns:repeat(4, 1fr);
  gap:15px;
}

.accion-btn{
  background:#f8fafc;
  border:none;
  border-radius:14px;
  padding:22px;
  display:flex;
  flex-direction:column;
  align-items:center;
  gap:10px;
  cursor:pointer;
  transition:.2s;
  font-family:inherit;
  appearance:none;
  -webkit-appearance:none;
}

.accion-btn i{
  font-size:1.6rem;
  color:#39A900;
}

.accion-btn span{
  font-size:.85rem;
  color:#374151;
  font-weight:500;
}

.accion-btn:hover{
  background:#dcfce7;
  transform:translateY(-3px);
}

@media(max-width:1100px){
  .stats-grid{ grid-template-columns:repeat(2, 1fr); }
  .two-col{ grid-template-columns:1fr; }
  .acciones-grid{ grid-template-columns:repeat(2, 1fr); }
}

@media(max-width:768px){
  .stats-grid{ grid-template-columns:1fr; }
  .acciones-grid{ grid-template-columns:1fr; }
}

</style>