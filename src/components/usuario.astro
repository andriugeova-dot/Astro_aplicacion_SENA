    justify-content:center;
    align-items:center;
    color:white;
    font-size:2.2rem;
    font-weight:bold;
    border:5px solid white;
}

.profile-card h2{
    text-align:center;
    color:#1f2937;
    margin-bottom:8px;
}

.profile-card p{
    text-align:center;
    color:#6b7280;
}

.divider{
    height:1px;
    background:#e5e7eb;
    margin:25px;
}

.info{
    padding:0 25px 25px;
}

.item{
    display:flex;
    justify-content:space-between;
    padding:14px 0;
    border-bottom:1px solid #f3f4f6;
}

.item:last-child{
