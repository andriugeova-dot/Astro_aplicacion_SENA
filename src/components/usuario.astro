---
// Este componente ya no recibe `aprendiz` por props desde el servidor:
// los datos se cargan en el cliente a partir de la sesión activa
// (ver el <script> al final y src/lib/auth.ts). Todo arranca con
// placeholders y se reemplaza cuando llega la respuesta.
---

<main class="dashboard">

    <section class="welcome">
        <div>
            <h1 id="saludo-nombre">¡Bienvenido!
                 <i class="bi bi-person-check-fill"></i>
            </h1>
            <p>Consulta toda la información de tu proceso de formación.</p>
        </div>
    </section>

    <section class="dashboard-grid">

        <!-- Perfil -->
        <aside class="profile-card">

            <div class="profile-top"></div>

            <div class="avatar">
                <span id="avatar-iniciales">--</span>
            </div>

            <h2 id="perfil-nombre">—</h2>

            <p>Aprendiz SENA</p>

            <div class="divider"></div>

            <div class="info">

                <div class="item">
                    <span>Documento</span>
                    <strong id="dato-documento">—</strong>
                </div>

                <div class="item">
                    <span>Correo</span>
                    <strong id="dato-correo">—</strong>
                </div>

                <div class="item">
                    <span>Teléfono</span>
                    <strong id="dato-telefono">—</strong>
                </div>

                <div class="item">
                     <span>Ficha</span>
                    <strong id="dato-ficha">—</strong>
                </div>

                <div class="item">
                    <span>Programa</span>
                    <strong id="dato-programa">—</strong>
                </div>


            </div>

        </aside>

        <!-- Contenido -->
        <section class="content">

            <div class="card">

                <h3>Información General</h3>

                <p>
                    Bienvenido a tu panel de aprendizaje.
                    Desde aquí podrás consultar tu información,
                    asignaturas, novedades y próximamente tu horario.
                </p>

                <div class="features">

                    <button type="button" class="feature" id="btn-info-personal">
                         Información Personal
                    </button>

                    <div class="feature"> Asignaturas</div>

                </div>

            </div>

            <div class="card empty">

              <div class="calendar">
                    <i class="bi bi-calendar3"></i>
                </div>

                <h3>
                    <i class="bi bi-clock-history"></i>
                    Horario
                </h3>

                <p>
                    Próximamente podrás visualizar aquí tu horario de formación.
                </p>

            </div>

            <div class="card">

                <h3>Próximamente</h3>

                <!-- <ul>

                    <li>Notificaciones</li>

                    <li>Asignaturas</li>

                    <li>Calificaciones</li>

                    <li>Asistencia</li>

                    <li>Seguimiento de formación</li>

                </ul> -->

            </div>

        </section>

    </section>

</main>


<dialog id="modal-info-personal" class="modal">

    <form method="dialog" class="modal-form" id="form-info-personal">

        <div class="modal-header">
            <h3>Editar información personal</h3>
            <button type="button" class="close-btn" id="close-modal">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>

        <div class="modal-body">

            <label>
                <span>Nombre</span>
                <input type="text" name="nombre" id="input-nombre" required />
            </label>

            <label>
                <span>Apellido</span>
                <input type="text" name="apellido" id="input-apellido" disabled />
            </label>

            <label>
                <span>Documento</span>
                <input type="text" name="documento" id="input-documento" disabled />
            </label>

            <label>
                <span>Correo</span>
                <input type="email" name="correo" id="input-correo" disabled />
            </label>

            <label>
                <span>Teléfono</span>
                <input type="tel" name="telefono" id="input-telefono" required />
            </label>

        </div>

        <div class="modal-footer">
            <button type="button" id="cancel-btn" class="btn-secondary">Cancelar</button>
            <button type="submit" class="btn-primary">Guardar cambios</button>
        </div>

    </form>

</dialog>

<script>
    import { obtenerSesion, fetchAutenticado } from "../lib/auth.ts";

    const apiUrl = import.meta.env.PUBLIC_API_URL ?? "http://localhost:8002";
    const sesion = obtenerSesion();

    // Layout.astro ya garantiza (vía exigirRol) que si llegamos hasta acá
    // hay sesión y el rol es aprendiz; esta comprobación es solo defensiva.
    let aprendizId: number | null = null;

    if (sesion) {
        const { usuario } = sesion;

        document.getElementById("saludo-nombre")!.innerHTML =
            `¡Bienvenido, ${usuario.nombre}! <i class="bi bi-person-check-fill"></i>`;
        document.getElementById("perfil-nombre")!.textContent = `${usuario.nombre} ${usuario.apellido}`;
        document.getElementById("avatar-iniciales")!.textContent =
            `${usuario.nombre.charAt(0)}${usuario.apellido.charAt(0)}`;
        document.getElementById("dato-correo")!.textContent = usuario.correo;

        // La tabla `aprendiz` no tiene todavía una FK hacia `usuario`
        // (ver asistencia_db.sql), así que buscamos su ficha técnica por
        // correo. Si el backend no soporta ese filtro aún, estos campos
        // simplemente se quedan en "—" sin romper la página; hay que
        // agregar ese endpoint (o el vínculo idUsuario -> idAprendiz)
        // en server_asistencias para que esto quede completo.
        (async () => {
            try {
                const respuesta = await fetchAutenticado(
                    `${apiUrl}/aprendiz?correo=${encodeURIComponent(usuario.correo)}`,
                );
                if (!respuesta.ok) return;

                const datos = await respuesta.json();
                const aprendiz = Array.isArray(datos) ? datos[0] : datos;
                if (!aprendiz) return;

                aprendizId = aprendiz.idAprendiz ?? null;
                document.getElementById("dato-documento")!.textContent = aprendiz.documento ?? "—";
                document.getElementById("dato-telefono")!.textContent = aprendiz.telefono ?? "—";
                document.getElementById("dato-ficha")!.textContent =
                    aprendiz.numeroFicha ?? (aprendiz.idFicha ? String(aprendiz.idFicha) : "—");
                document.getElementById("dato-programa")!.textContent = aprendiz.programa ?? "—";
            } catch (_error) {
                // Sin conexión o endpoint no disponible todavía: se deja el placeholder.
            }
        })();
    }

    const modal = document.getElementById("modal-info-personal") as HTMLDialogElement;
    const openBtn = document.getElementById("btn-info-personal")!;
    const closeBtn = document.getElementById("close-modal")!;
    const cancelBtn = document.getElementById("cancel-btn")!;
    const form = document.getElementById("form-info-personal") as HTMLFormElement;

    openBtn.addEventListener("click", () => {
        // Precarga el formulario con lo que tengamos cargado hasta ahora.
        (document.getElementById("input-nombre") as HTMLInputElement).value =
            sesion?.usuario.nombre ?? "";
        (document.getElementById("input-apellido") as HTMLInputElement).value =
            sesion?.usuario.apellido ?? "";
        (document.getElementById("input-correo") as HTMLInputElement).value =
            sesion?.usuario.correo ?? "";
        (document.getElementById("input-documento") as HTMLInputElement).value =
            document.getElementById("dato-documento")?.textContent ?? "";
        (document.getElementById("input-telefono") as HTMLInputElement).value =
            document.getElementById("dato-telefono")?.textContent === "—"
                ? ""
                : (document.getElementById("dato-telefono")?.textContent ?? "");

        modal.showModal();
    });

    closeBtn.addEventListener("click", () => modal.close());
    cancelBtn.addEventListener("click", () => modal.close());

    form.addEventListener("submit", async (e) => {
        e.preventDefault();

        if (!aprendizId) {
            alert("Todavía no se pudo identificar tu ficha de aprendiz; intenta de nuevo en un momento.");
            return;
        }

        const formData = new FormData(form);
        const nombre = formData.get("nombre");
        const telefono = formData.get("telefono");

        try {
            const res = await fetchAutenticado(`${apiUrl}/aprendiz/${aprendizId}`, {
                method: "PATCH",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ nombre, telefono }),
            });

            if (!res.ok) {
                throw new Error("No se pudo actualizar");
            }

            // recarga la página para reflejar los cambios
            window.location.reload();
        } catch (err) {
            alert("Ocurrió un error al guardar los cambios.");
            console.error(err);
        }
    });
</script>

<style>

.dashboard{
    max-width:1300px;
    margin:auto;
    padding:40px 20px;
}

