---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Asistencias SENA">
	<div class="redireccionando">
		<div class="spinner-border" role="status">
			<span class="visually-hidden">Cargando…</span>
		</div>
	</div>
</Layout>

<script>
	import { obtenerSesion, obtenerRutaPorRol } from '../lib/auth.ts';
	const sesion = obtenerSesion();
	window.location.replace(sesion ? obtenerRutaPorRol(sesion.usuario.idRol) : '/login');
</script>

<style>
	.redireccionando {
		min-height: 100vh;
		display: flex;
		align-items: center;
		justify-content: center;
		color: var(--sena-verde-oscuro);
	}
</style>
