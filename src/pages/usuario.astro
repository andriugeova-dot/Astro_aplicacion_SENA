---
import Layout from "../layouts/Layout.astro";
import Usuario from "../components/usuario.astro";

// Antes esta página hacía un fetch en el servidor a /aprendiz/5 (fijo,
// sin importar quién inició sesión, y sin token). Ahora los datos del
// aprendiz logueado se cargan en el cliente dentro de <Usuario />,
// usando la sesión guardada por el login (ver src/lib/auth.ts).
const links = [
  { text: "Dashboard", href: "/usuario", icon: "bi-house-door-fill" },
  { text: "Horario", href: "/horario", icon: "bi-calendar3" },
  { text: "Asignaturas", href: "/asignaturas", icon: "bi-journal-bookmark-fill" },
  { text: "Asistencia", href: "/asistencia", icon: "bi-clipboard2-check-fill" },
];
---

<!-- rolesPermitidos={[1]}: solo aprendices (idRol 1) pueden ver este panel. -->
<Layout title="Dashboard" links={links} subtitulo="Aprendiz" rolesPermitidos={[1]}>
  <Usuario />
</Layout>