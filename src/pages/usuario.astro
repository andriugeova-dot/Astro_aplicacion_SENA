---
import Layout from "../layouts/Layout.astro";
import Usuario from "../components/usuario.astro";

const API=import.meta.env.PUBLIC_API_URL;

const respuesta=await fetch(`${API}/aprendiz/4`);

const aprendiz=await respuesta.json();
---

<Layout

title="Dashboard"

aprendiz={aprendiz}

links={[

{
text:"Dashboard",
href:"/usuario"
},

{
text:"Horario",
href:"/horario"
},

{
text:"Asignaturas",
href:"/asignaturas"
},

{
text:"Asistencia",
href:"/asistencia"
}

]}

>

<Usuario aprendiz={aprendiz}/>

</Layout>