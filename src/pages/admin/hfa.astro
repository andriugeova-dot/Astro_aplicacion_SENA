---
import Layout from "../../layouts/Layout.astro";
import AdminTablaCRUD from "../../components/admin/AdminTablaCRUD.astro";

const links = [
  { text: "Dashboard", href: "/admin", icon: "bi-house-door-fill" },
  { text: "Usuarios", href: "/admin/usuarios", icon: "bi-people-fill" },
  { text: "Aprendices", href: "/admin/aprendices", icon: "bi-person-badge-fill" },
  { text: "Fichas", href: "/admin/fichas", icon: "bi-journal-bookmark-fill" },
  { text: "Programas", href: "/admin/programas", icon: "bi-mortarboard-fill" },
  { text: "Asignaturas", href: "/admin/asignaturas", icon: "bi-book-fill" },
  { text: "Horarios", href: "/admin/horarios", icon: "bi-calendar3" },
  { text: "Bloques (HFA)", href: "/admin/hfa", icon: "bi-diagram-3-fill" },
  { text: "Roles", href: "/admin/roles", icon: "bi-shield-lock-fill" },
];
---

<Layout title="Bloques HFA | Panel Admin" links={links} subtitulo="admin" rolesPermitidos={[3]}>
  <AdminTablaCRUD
    titulo="Bloques Horario-Ficha-Asignatura"
    descripcion="Une una ficha, un horario y una asignatura: cada fila es el bloque de clase sobre el que luego se registra la asistencia."
    entidadSingular="Bloque HFA"
    endpoint="/hfa"
    idField="idHFA"
    columnas={[
      { field: "idHFA", headerName: "ID", minWidth: 90 },
      { field: "idFicha", headerName: "Ficha", minWidth: 180 },
      { field: "idHorario", headerName: "Horario", minWidth: 200 },
      { field: "idAsignatura", headerName: "Asignatura", minWidth: 200 },
    ]}
    camposFormulario={[
      {
        field: "idFicha",
        label: "Ficha",
        type: "select",
        required: true,
        fuenteRemota: { endpoint: "/ficha", valueField: "idFicha", labelField: "numeroFicha" },
      },
      {
        field: "idHorario",
        label: "Horario",
        type: "select",
        required: true,
        fuenteRemota: { endpoint: "/horario", valueField: "idHorario", labelField: "diaSemana" },
        ayuda: "Se muestra el día; revisa la hora en la sección Horarios si tienes varios bloques el mismo día.",
      },
      {
        field: "idAsignatura",
        label: "Asignatura",
        type: "select",
        required: true,
        fuenteRemota: { endpoint: "/asignatura", valueField: "idAsignatura", labelField: "nombreAsignatura" },
      },
    ]}
  />
</Layout>
