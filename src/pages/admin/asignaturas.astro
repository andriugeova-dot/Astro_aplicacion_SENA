---
import Layout from "../../layouts/Layout.astro";
import AdminTablaCRUD from "../../components/admin/AdminTablaCRUD.astro";

const links = [
  { text: "Dashboard", href: "/admin", icon: "bi-house-door-fill" },
  { text: "Usuarios", href: "/admin/usuarios", icon: "bi-people-fill" },
  { text: "Aprendices", href: "/admin/aprendices", icon: "bi-person-badge-fill" },
  { text: "Fichas", href: "/admin/fichas", icon: "bi-journal-bookmark-fill" },
  { text: "Programas", href: "/admin/programas", icon: "bi-mortarboard-fill" },
  { text: "Asignaturas", href: "/admin/asignaturas", icon: "bi-book-fill" },
  { text: "Horarios", href: "/admin/horarios", icon: "bi-calendar3" },
  { text: "Bloques (HFA)", href: "/admin/hfa", icon: "bi-diagram-3-fill" },
  { text: "Roles", href: "/admin/roles", icon: "bi-shield-lock-fill" },
];
---

<Layout title="Asignaturas | Panel Admin" links={links} subtitulo="admin" rolesPermitidos={[3]}>
  <AdminTablaCRUD
    titulo="Asignaturas"
    descripcion="Administra las asignaturas que se dictan en las fichas."
    entidadSingular="Asignatura"
    endpoint="/asignatura"
    idField="idAsignatura"
    columnas={[
      { field: "idAsignatura", headerName: "ID", minWidth: 90 },
      { field: "nombreAsignatura", headerName: "Nombre", minWidth: 220 },
      { field: "descripcion", headerName: "Descripción", minWidth: 260 },
    ]}
    camposFormulario={[
      { field: "nombreAsignatura", label: "Nombre de la asignatura", type: "text", required: true },
      { field: "descripcion", label: "Descripción", type: "textarea" },
    ]}
  />
</Layout>
