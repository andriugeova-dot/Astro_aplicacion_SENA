---
import LayoutUsuariosAstroComponent from "../layouts/layoutUsuarios.astro";
import AdminAstro from "../components/Admin.astro";
import Layout from "../layouts/Layout.astro";
import DashboardAdmin from "../components/Admin.astro";


const admin = {
  nombre: "",
  apellido: "",
};


const API = import.meta.env.PUBLIC_API_URL;



const links = [
  { text: "Dashboard", href: "/admin", icon: "bi-house-door-fill" },
  { text: "Usuarios", href: "/admin/usuarios", icon: "bi-people-fill" },
  { text: "Fichas", href: "/admin/fichas", icon: "bi-journal-bookmark-fill" },
  { text: "Programas", href: "/admin/programas", icon: "bi-mortarboard-fill" },
  { text: "Asignaturas", href: "/admin/asignaturas", icon: "bi-book-fill" },
  { text: "Horarios", href: "/admin/horarios", icon: "bi-calendar3" },
  { text: "Roles", href: "/admin/roles", icon: "bi-shield-lock-fill" },
];
---

<Layout title="Panel del Admin" links={links} subtitulo="admin" rolesPermitidos={[3]}>
  <DashboardAdmin admin={admin} />
</Layout>

<script>
  import { obtenerSesion } from "../lib/auth.ts";

  const sesion = obtenerSesion();
  if (sesion) {
    const el = document.getElementById("nombre-admin");
    if (el) el.textContent = `${sesion.usuario.nombre} ${sesion.usuario.apellido}`;
  }
</script>
